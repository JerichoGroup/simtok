@startuml system_communications

title SimTok — System Communications

' === Global styling ===
skinparam backgroundColor #FDFDFD
skinparam shadowing false
skinparam roundCorner 10
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55

skinparam package {
    BorderColor #6B7B8C
    BackgroundColor #F4F7FA
    FontColor #2C3E50
    FontStyle bold
}

skinparam component {
    BorderColor #4A90D9
    BackgroundColor #EAF3FB
    FontColor #1F3A54
}

skinparam database {
    BorderColor #7AA05A
    BackgroundColor #EEF5E6
}

skinparam ArrowColor #5B6B7B
skinparam ArrowFontColor #55606B
skinparam ArrowThickness 1

package "CLI" {
    [simtok_cli.py]
}

package "Data Collection" {
    [collect.py]
    [random_povs.py]
    [zoom_manager.py]
}

package "Isaac Sim" {
    [gray_scale.py]
    [zoom_node.py]
    [bbox_publisher]
    [udp_camera]
}

package "Capture (dev_kit)" {
    [VideoCapture]
    [PoseCapture]
    [BboxCapture]
}

package "Post-Processing" {
    [noise_processor.py]
    [json_creation.py]
}

package "Config" {
    [config.py]
    [simtok_config.toml]
}

database "data/" {
    [videos/]
    [poses/]
    [bboxes/]
    [noise_videos/]
    [jsons/]
}

' === API calls ===
[simtok_cli.py] -[#4A90D9]-> [collect.py]
[simtok_cli.py] -[#4A90D9]-> [noise_processor.py]
[simtok_cli.py] -[#4A90D9]-> [json_creation.py]

[collect.py] -[#4A90D9]-> [zoom_manager.py]
[collect.py] -[#4A90D9]-> [random_povs.py]
[collect.py] -[#4A90D9]-> [VideoCapture]
[collect.py] -[#4A90D9]-> [PoseCapture]
[collect.py] -[#4A90D9]-> [BboxCapture]

' === ROS2 topics ===
[collect.py] -[#C0392B,bold]-> [gray_scale.py] : /simtok/reset_oscillation\n/simtok/new_oscillation
[zoom_manager.py] -[#C0392B,bold]-> [zoom_node.py] : /simtok/zoom
[bbox_publisher] -[#C0392B,bold]-> [gray_scale.py] : /isaac_core/bbox

' === UDP ===
[collect.py] -[#E67E22,dashed]-> [udp_camera] : UDP

' === File I/O ===
[VideoCapture] .[#7AA05A].> [videos/]
[PoseCapture] .[#7AA05A].> [poses/]
[BboxCapture] .[#7AA05A].> [bboxes/]

[noise_processor.py] .[#7AA05A].> [videos/] : reads
[noise_processor.py] .[#7AA05A].> [noise_videos/] : writes

[json_creation.py] .[#7AA05A].> [poses/] : reads
[json_creation.py] .[#7AA05A].> [bboxes/] : reads
[json_creation.py] .[#7AA05A].> [jsons/] : writes

' === Shared configuration ===
[config.py] .[#95A5A6].> [simtok_config.toml] : loads
[collect.py] .[#95A5A6].> [config.py] : reads
[random_povs.py] .[#95A5A6].> [config.py] : reads
[zoom_manager.py] .[#95A5A6].> [config.py] : reads
[noise_processor.py] .[#95A5A6].> [config.py] : reads
[json_creation.py] .[#95A5A6].> [config.py] : reads
[gray_scale.py] .[#95A5A6].> [config.py] : reads
[zoom_node.py] .[#95A5A6].> [config.py] : reads

@enduml
